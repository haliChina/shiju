[{"author":"孔子","content":"学而时习之，不亦说乎？","createdAt":1735689600000,"favorite":false,"id":"vq-0001","rating":0,"source":"《论语·学而》","tags":["学习","经典"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"《论语·学而》篇首句，核对通行本原文。"},{"author":"孔子","content":"己所不欲，勿施于人。","createdAt":1735689601000,"favorite":false,"id":"vq-0002","rating":0,"source":"《论语·颜渊》","tags":["哲思","经典"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"《论语·颜渊》仲弓问仁章，核对通行本原文。"},{"author":"孔子","content":"三人行，必有我师焉。择其善者而从之，其不善者而改之。","createdAt":1735689602000,"favorite":false,"id":"vq-0003","rating":0,"source":"《论语·述而》","tags":["学习","哲思"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"收录完整两句，坊间常只引首句。"},{"author":"屈原","content":"路漫漫其修远兮，吾将上下而求索。","createdAt":1735689603000,"favorite":false,"id":"vq-0004","rating":0,"source":"屈原《离骚》","tags":["诗词","励志"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《楚辞·离骚》原文。"},{"author":"李白","content":"天生我材必有用，千金散尽还复来。","createdAt":1735689604000,"favorite":false,"id":"vq-0005","rating":0,"source":"李白《将进酒》","tags":["诗词","励志"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《将进酒》原文。"},{"author":"李白","content":"安能摧眉折腰事权贵，使我不得开心颜。","createdAt":1735689605000,"favorite":false,"id":"vq-0006","rating":0,"source":"李白《梦游天姥吟留别》","tags":["诗词","人生"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《梦游天姥吟留别》结尾原文。"},{"author":"王勃","content":"海内存知己，天涯若比邻。","createdAt":1735689606000,"favorite":false,"id":"vq-0007","rating":0,"source":"王勃《送杜少府之任蜀州》","tags":["诗词","情感"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对原诗颈联原文。"},{"author":"刘禹锡","content":"沉舟侧畔千帆过，病树前头万木春。","createdAt":1735689607000,"favorite":false,"id":"vq-0008","rating":0,"source":"刘禹锡《酬乐天扬州初逢席上见赠》","tags":["诗词","励志"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对原诗颈联原文。"},{"author":"陆游","content":"山重水复疑无路，柳暗花明又一村。","createdAt":1735689608000,"favorite":false,"id":"vq-0009","rating":0,"source":"陆游《游山西村》","tags":["诗词","人生"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对原诗颈联原文。"},{"author":"陆游","content":"纸上得来终觉浅，绝知此事要躬行。","createdAt":1735689609000,"favorite":false,"id":"vq-0010","rating":0,"source":"陆游《冬夜读书示子聿》","tags":["诗词","学习"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对原诗尾联原文。"},{"author":"王安石","content":"不畏浮云遮望眼，自缘身在最高层。","createdAt":1735689610000,"favorite":false,"id":"vq-0011","rating":0,"source":"王安石《登飞来峰》","tags":["诗词","哲思"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"通行本作「自缘」，坊间常误作「只缘」，此处从原诗。"},{"author":"文天祥","content":"人生自古谁无死，留取丹心照汗青。","createdAt":1735689611000,"favorite":false,"id":"vq-0012","rating":0,"source":"文天祥《过零丁洋》","tags":["诗词","经典"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对原诗尾联原文。"},{"author":"范仲淹","content":"先天下之忧而忧，后天下之乐而乐。","createdAt":1735689612000,"favorite":false,"id":"vq-0013","rating":0,"source":"范仲淹《岳阳楼记》","tags":["文学","经典"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《岳阳楼记》原文。"},{"author":"韩愈","content":"业精于勤，荒于嬉；行成于思，毁于随。","createdAt":1735689613000,"favorite":false,"id":"vq-0014","rating":0,"source":"韩愈《进学解》","tags":["学习","经典"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《进学解》原文。"},{"author":"颜真卿","content":"黑发不知勤学早，白首方悔读书迟。","createdAt":1735689614000,"favorite":false,"id":"vq-0015","rating":0,"source":"颜真卿《劝学诗》","tags":["诗词","学习"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《劝学诗》尾联原文。"},{"author":"刘备","content":"勿以恶小而为之，勿以善小而不为。","createdAt":1735689615000,"favorite":false,"id":"vq-0016","rating":0,"source":"《三国志·蜀书·先主传》","tags":["哲思","经典"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"刘备遗诏敕后主语，陈寿《三国志》原文收录。"},{"author":"曹操","content":"老骥伏枥，志在千里；烈士暮年，壮心不已。","createdAt":1735689616000,"favorite":false,"id":"vq-0017","rating":0,"source":"曹操《龟虽寿》","tags":["诗词","励志"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《步出夏门行·龟虽寿》原文。"},{"author":"林则徐","content":"苟利国家生死以，岂因祸福避趋之。","createdAt":1735689617000,"favorite":false,"id":"vq-0018","rating":0,"source":"林则徐《赴戍登程口占示家人》","tags":["诗词","经典"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对原诗尾联原文。"},{"author":"于谦","content":"粉身碎骨浑不怕，要留清白在人间。","createdAt":1735689618000,"favorite":false,"id":"vq-0019","rating":0,"source":"于谦《石灰吟》","tags":["诗词","人生"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"核对《石灰吟》尾联原文；一作「粉骨碎身浑不怕」，此处从通行本。"},{"author":"鲁迅","content":"其实地上本没有路，走的人多了，也便成了路。","createdAt":1735689619000,"favorite":false,"id":"vq-0020","rating":0,"source":"鲁迅《故乡》","tags":["文学","哲思"],"verified":true,"verifiedAt":"2026-11-21","verifyNote":"《故乡》结尾原文，坊间常删节为「世上本没有路」，此处收录完整原句。"}]